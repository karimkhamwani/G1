# ── Market selection ─────────────────────────────────────────
# Slugs are constructed as {asset}-updown-{5m|15m}-{windowStartUnix} from ASSETS+DURATIONS
ASSETS=BTC,ETH
DURATIONS=5m,15m
#.venv\Scripts\pip install -e .[live]
#.venv/Scripts/python.exe -m bot.main

# ── Run mode ─────────────────────────────────────────────────
MODE=paper                         # paper | live

# ── Signal ───────────────────────────────────────────────────
VOL_WINDOW_MIN=30
MOMENTUM_EWMA_S=5,30
FINAL_BLACKOUT_S=20                # no new skew entries in last N seconds

# ── Scaling (Layer 1: two-sided accumulation) ────────────────
BASE_SHARES=20                     # initial equal YES+NO position per market
ENTRY_WINDOW_S=30                  # place base entry within N seconds of market open
ADD_TRIGGER_DROP=0.05              # add to a side when ask < that side's avg_cost - this
ADD_MARGIN=0.03                    # model gate: ask must also be <= fair - this (net of fees)
ADD_STEP_SHARES=10                 # shares per averaging add
ADD_JITTER_PCT=0.25                # randomize step size/price ±25%
CHOP_SCORE_MIN=2.0                 # regime gate: range / |net move| must exceed this
MIN_NET_MOVE_FRAC=0.0008           # regime: net move below this fraction = "no character yet"
MIN_WINDOW_AGE_S=20                # no ladder adds before the window is this old
MODEL_BOOK_DIVERGENCE_MAX=0.15     # |fair - book mid| beyond this: distrust the model, skip adds
MAX_ADDS_PER_SIDE_5M=3
STEP_DECAY_5M=0.7
MAX_ADDS_PER_SIDE_15M=6
STEP_DECAY_15M=0.85
MAX_SHARES_PER_SIDE=60

# ── Skew (Layer 2: momentum direction) ───────────────────────
SKEW_ENABLED=true   # false disables layer 2 (momentum skew) entirely
SKEW_THRESHOLD=0.05                # min |fair_yes - book_mid| with confluence
SKEW_STEP_SHARES=10
MAX_SKEW_SHARES=40
BOOK_IMBALANCE_MIN=0.2             # min |bid-ask depth imbalance| for book lean

# ── Risk ─────────────────────────────────────────────────────
MAX_SHARES_PER_MARKET=120
MAX_PER_MARKET_USDC=25
MAX_CONCURRENT_MARKETS=4
MAX_TOTAL_EXPOSURE_USDC=150
MAX_DAILY_LOSS_USDC=40             # kill switch
FEED_STALE_S=2

# ── Dashboard ────────────────────────────────────────────────
DASHBOARD_PORT=8080                # 0 disables the dashboard
DASHBOARD_HOST=127.0.0.1           # bind local only; never expose publicly

# ── Execution ────────────────────────────────────────────────
MIN_ORDER_SHARES=5                 # Polymarket rejects orders smaller than this
ORDER_TTL_S=10
MIN_BOOK_DEPTH_USDC=200
TAKE_PROFIT_LEVELS=0.90,0.97
FAST_CANCEL_SPOT_MOVE=0.0008       # pull resting bids if spot moves this fraction against them
FEE_REFRESH_MIN=30
DEFAULT_FEE_BPS=1000               # assumed when the fee fetch fails or returns 0
PAPER_LATENCY_MS=300               # simulated order latency in paper mode

# ── Endpoints (Polymarket CLOB v2) ───────────────────────────
CLOB_HOST=https://clob.polymarket.com
CLOB_WS=wss://ws-subscriptions-clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
BINANCE_WS=wss://data-stream.binance.vision
CHAIN_ID=137

# ── Recording ────────────────────────────────────────────────
DATA_DIR=data

# ── Credentials (never committed; required for MODE=live) ────
POLYGON_WALLET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=         # your Polymarket deposit/proxy address (shown in the UI)
POLYMARKET_SIGNATURE_TYPE=1        # 1 = email/Magic login account, 2 = browser-wallet account
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
